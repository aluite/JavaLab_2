import java.util.*;
import java.lang.*;
import java.io.*;

public class HelloWord {
    public static void main(String[] args) {
        for (int i = 1000; i <= 2000; i++) {
            System.out.print(i + " ");
            if ((i - 999) % 5 == 0) {
                System.out.println();
            }
        }
    }
}
