import java.util.*;
import java.lang.*;
import java.io.*;

public class HelloWord {
    public static void main(String[] args) {
        if (args.length != 1){
            System.out.println("n =");
            return;
        }
        long n = Long.parseLong(args[0]);
        for (long power = 2; power <= n; power *=2){
            System.out.println(power);
        }
    }
}
